{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-pm.local/contracts/v1/control-scenario.v1",
  "title": "Control Scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "scenario_id",
    "scope",
    "requested_by",
    "purpose_key",
    "changes",
    "assumptions",
    "source_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "control-scenario.v1"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "project_id",
        "project_revision"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "project_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "requested_by": {
      "type": "string",
      "minLength": 1
    },
    "purpose_key": {
      "type": "string",
      "minLength": 1
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "change_id",
          "domain",
          "entity_type",
          "entity_id",
          "operation",
          "proposed_value",
          "source_refs"
        ],
        "properties": {
          "change_id": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "entity_type": {
            "type": "string",
            "minLength": 1
          },
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "proposed_value": {
            "type": "object"
          },
          "source_refs": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    "assumptions": {
      "type": "object"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1
    }
  }
}
