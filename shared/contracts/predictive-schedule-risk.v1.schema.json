{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-pm.local/contracts/predictive-schedule-risk.v1.schema.json",
  "title": "Predictive Schedule Risk v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "risk_id",
    "scope",
    "risk_type",
    "horizon_key",
    "likelihood",
    "impact",
    "confidence",
    "title_key",
    "detail_key",
    "affected_domains",
    "source_refs",
    "model_version"
  ],
  "properties": {
    "contract_version": {
      "const": "predictive-schedule-risk.v1"
    },
    "risk_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "project_id",
        "project_revision"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "project_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "risk_type": {
      "type": "string",
      "minLength": 1
    },
    "horizon_key": {
      "type": "string",
      "minLength": 1
    },
    "likelihood": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "impact": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "title_key": {
      "type": "string",
      "minLength": 1
    },
    "detail_key": {
      "type": "string",
      "minLength": 1
    },
    "affected_domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "schedule",
          "progress",
          "evm",
          "resource",
          "cost",
          "document",
          "change",
          "claim",
          "procurement",
          "field"
        ]
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_type",
          "locator",
          "revision"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "excerpt_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_hash": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "model_version": {
      "type": "string",
      "minLength": 1
    },
    "attributes": {
      "type": "object"
    }
  }
}
