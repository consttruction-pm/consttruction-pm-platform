        "en"
      ],
      "capabilities": {
        "ui": true,
        "help": true,
        "ai_text": true,
        "voice_input": true,
        "voice_output": true,
        "offline_ai": false
      }
    }
  ],
  "title": "Construction PM Language Registry Example",
  "$id": "https://construction-pm.local/contracts/language-registry-example.v1.schema.json",
