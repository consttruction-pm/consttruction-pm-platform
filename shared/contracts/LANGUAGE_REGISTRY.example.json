{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "1.0",
  "default_language": "en",
  "languages": [
    {
      "language_tag": "en",
      "display_names": {
        "en": "English",
        "fa": "انگلیسی"
      },
      "enabled": true,
      "direction": "ltr",
      "locale": "en-US",
      "fallback_chain": [],
      "capabilities": {
        "ui": true,
        "help": true,
        "ai_text": true,
        "voice_input": true,
        "voice_output": true,
        "offline_ai": false
      },
      "typography": {
        "font_family": "Inter",
        "fallback_families": [
          "Segoe UI",
          "Arial",
          "sans-serif"
        ],
        "font_style": "normal",
        "font_weight": 400,
        "line_height": "1.5",
        "letter_spacing": "normal",
        "font_feature_settings": "normal",
        "font_variant_ligatures": "common-ligatures",
        "font_kerning": "auto"
      }
    },
    {
      "language_tag": "fa",
      "display_names": {
        "en": "Persian",
        "fa": "فارسی"
      },
      "enabled": true,
      "direction": "rtl",
      "locale": "fa-IR",
      "fallback_chain": [
        "en"
      ],
      "capabilities": {
        "ui": true,
        "help": true,
        "ai_text": true,
        "voice_input": true,
        "voice_output": true,
        "offline_ai": false
      },
      "typography": {
        "font_family": "Vazirmatn",
        "fallback_families": [
          "Noto Sans Arabic",
          "Tahoma",
          "Arial",
          "sans-serif"
        ],
        "font_style": "normal",
        "font_weight": 400,
        "line_height": "1.7",
        "letter_spacing": "normal",
        "font_feature_settings": "normal",
        "font_variant_ligatures": "common-ligatures",
        "font_kerning": "auto"
      }
    }
  ],
  "title": "Construction PM Language Registry Example",
  "$id": "https://construction-pm.local/contracts/language-registry-example.v1.schema.json",
  "x-contract-version": "1.0"
}
