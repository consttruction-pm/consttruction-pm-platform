{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-pm.local/contracts/v1/project-portability.schema.json",
  "title": "Project Portability Context v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tenant_id",
    "project_id",
    "project_revision",
    "calendar_context",
    "scheduling_settings",
    "calculation_settings",
    "resource_cost_config",
    "module_refs"
  ],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "project_revision": {"type": "integer", "minimum": 0},
    "calendar_context": {"type": "object"},
    "scheduling_settings": {"type": "object"},
    "calculation_settings": {"type": "object"},
    "resource_cost_config": {"type": "object"},
    "module_refs": {"type": "object"}
  }
}
