{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://consttruction-pm.github.io/contracts/v1/enterprise-identity-claims.json",
  "title":"Enterprise Identity Claims v1",
  "type":"object","additionalProperties":false,
  "required":["contract_version","subject","issuer","auth_method","tenant_id","roles"],
  "properties":{
    "contract_version":{"const":"1.0"},
    "subject":{"type":"string","minLength":1},
    "issuer":{"type":"string","minLength":1},
    "auth_method":{"enum":["oidc","saml"]},
    "tenant_id":{"type":"string","minLength":1},
    "email":{"type":["string","null"]},
    "display_name":{"type":["string","null"]},
    "roles":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true}
  }
}