{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-pm.local/contracts/v1/procurement-bid-comparison.v1",
  "title": "Procurement Bid Comparison v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "comparison_id",
    "scope",
    "rfq_id",
    "status",
    "entries",
    "audit",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "procurement-bid-comparison.v1"
    },
    "comparison_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "rfq_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "under_review",
        "approved",
        "rejected",
        "closed"
      ]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "quote_id",
          "supplier_id",
          "compliance_status"
        ],
        "properties": {
          "quote_id": {
            "type": "string",
            "minLength": 1
          },
          "supplier_id": {
            "type": "string",
            "minLength": 1
          },
          "compliance_status": {
            "type": "string",
            "enum": [
              "compliant",
              "partial",
              "non_compliant",
              "not_evaluated"
            ]
          },
          "evaluator_notes_key": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "technical_reference": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "commercial_reference": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    },
    "selected_quote_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "selected_supplier_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "decision_reference": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "audit": {
      "$ref": "#/$defs/audit"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "project_id",
        "project_revision"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "project_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_by",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "locator",
        "revision"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "money": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
    },
    "qty": {
      "type": "string",
      "pattern": "^(?!0+(?:\\.0+)?$)(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
    }
  }
}
