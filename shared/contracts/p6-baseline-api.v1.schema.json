{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P6 Baseline API v1",
  "type": "object",
  "required": ["contract_version", "kind", "scope", "baseline"],
  "properties": {
    "contract_version": {"const": "p6-baseline-api.v1"},
    "kind": {"const": "p6_baseline"},
    "scope": {
      "type": "object",
      "required": ["tenant_id", "project_id", "project_revision"],
      "properties": {
        "tenant_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "project_revision": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "required": ["baseline_id", "name", "baseline_type", "source_revision", "created_at"],
      "properties": {
        "baseline_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "baseline_type": {"enum": ["PRIMARY", "SECONDARY", "TERTIARY", "USER_SELECTED"]},
        "source_revision": {"type": "integer", "minimum": 0},
        "created_at": {"type": "string", "minLength": 1},
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
