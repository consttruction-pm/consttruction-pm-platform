{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-pm.local/contracts/v1/claim-record.v1",
  "title": "Claim Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "claim_id",
    "scope",
    "claim_type",
    "status",
    "title_key",
    "submitted_by",
    "audit",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "claim-record.v1"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "extension_of_time",
        "compensation",
        "variation",
        "delay",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "under_review",
        "accepted",
        "partially_accepted",
        "rejected",
        "settled",
        "closed",
        "withdrawn"
      ]
    },
    "title_key": {
      "type": "string",
      "minLength": 1
    },
    "detail_key": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "submitted_by": {
      "type": "string",
      "minLength": 1
    },
    "originating_notice_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "change_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "schedule_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cost_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "impact_link_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entitlement_reference": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "quantum_reference": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "decision_reference": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "approval_required": {
      "type": "boolean"
    },
    "decided_by": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "decided_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "audit": {
      "$ref": "#/$defs/audit"
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "project_id",
        "project_revision"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "project_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_by",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "locator",
        "revision"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
