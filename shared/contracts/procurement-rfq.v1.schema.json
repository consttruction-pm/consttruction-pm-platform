{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-pm.local/contracts/procurement-rfq.v1.schema.json",
  "title": "Procurement RFQ v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "rfq_id",
    "scope",
    "status",
    "title_key",
    "requested_by",
    "items",
    "supplier_ids",
    "audit"
  ],
  "properties": {
    "contract_version": {
      "const": "procurement-rfq.v1"
    },
    "rfq_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "project_id",
        "project_revision"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "project_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "issued",
        "clarification",
        "closed",
        "cancelled",
        "awarded"
      ]
    },
    "title_key": {
      "type": "string",
      "minLength": 1
    },
    "requested_by": {
      "type": "string",
      "minLength": 1
    },
    "due_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "description_key",
          "quantity",
          "unit"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "description_key": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "activity_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "attributes": {
            "type": "object"
          }
        }
      }
    },
    "supplier_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_by",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "attributes": {
      "type": "object"
    }
  }
}
