{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-pm.local/contracts/v1/procurement-delivery.v1",
  "title": "Procurement Delivery v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "delivery_id",
    "scope",
    "po_id",
    "supplier_id",
    "status",
    "delivery_date",
    "items",
    "audit",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "procurement-delivery.v1"
    },
    "delivery_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "po_id": {
      "type": "string",
      "minLength": 1
    },
    "supplier_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "partial",
        "received",
        "rejected",
        "cancelled"
      ]
    },
    "delivery_date": {
      "type": "string",
      "format": "date"
    },
    "location_key": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "quantity_received",
          "unit"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "quantity_received": {
            "$ref": "#/$defs/qty"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "inspection_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "punch_id": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "acceptance_status": {
            "type": "string",
            "enum": [
              "pending",
              "accepted",
              "rejected",
              "partial"
            ]
          }
        }
      }
    },
    "receipt_reference": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "audit": {
      "$ref": "#/$defs/audit"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "project_id",
        "project_revision"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "project_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_by",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "locator",
        "revision"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "money": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
    },
    "qty": {
      "type": "string",
      "pattern": "^(?!0+(?:\\.0+)?$)(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
    }
  }
}
