{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://consttruction-pm.github.io/contracts/v1/erp-accounting-sync-result.json",
  "title":"ERP Accounting Sync Result v1",
  "type":"object","additionalProperties":false,
  "required":["contract_version","tenant_id","project_id","operation_id","status","external_reference"],
  "properties":{
    "contract_version":{"const":"1.0"},
    "tenant_id":{"type":"string","minLength":1},
    "project_id":{"type":"string","minLength":1},
    "operation_id":{"type":"string","minLength":1},
    "status":{"enum":["accepted","rejected","retry"]},
    "external_reference":{"type":["string","null"]},
    "message":{"type":"string"}
  }
}