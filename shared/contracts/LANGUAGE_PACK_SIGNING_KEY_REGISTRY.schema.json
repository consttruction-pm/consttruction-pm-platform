{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Construction PM Language Pack Signing Key Registry",
  "type": "object",
  "required": ["schema_version", "keys"],
  "properties": {
    "schema_version": {"type": "string"},
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key_id",
          "algorithm",
          "public_key_base64url",
          "status"
        ],
        "properties": {
          "key_id": {"type": "string", "minLength": 1},
          "algorithm": {"const": "Ed25519"},
          "public_key_base64url": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
          "status": {"enum": ["active", "retired", "revoked"]},
          "not_before": {"type": ["string", "null"]},
          "not_after": {"type": ["string", "null"]}
        }
      }
    }
  }
}
