{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cubi.dev/enterprise-task/v1",
  "title": "CUBI Enterprise Task",
  "description": "Tenant-scoped task contract. References to Engineering objects are opaque links and never grant access to those objects.",
  "type": "object",
  "required": [
    "contract_version",
    "task_id",
    "tenant_id",
    "title",
    "created_by_user_id",
    "created_at",
    "status",
    "priority",
    "assigned_user_id",
    "assigned_team_id",
    "project_id",
    "due_at",
    "dependency_ids",
    "related_refs",
    "revision",
    "updated_at",
    "completed_at",
    "completed_by_user_id"
  ],
  "properties": {
    "contract_version": {
      "const": "cubi-enterprise-task.v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "description": {
      "type": ["string", "null"],
      "maxLength": 10000
    },
    "created_by_user_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["open", "in_progress", "blocked", "completed", "cancelled"]
    },
    "priority": {
      "type": "string",
      "enum": ["low", "normal", "high", "urgent"]
    },
    "assigned_user_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 200
    },
    "assigned_team_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 200
    },
    "project_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 200
    },
    "due_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "dependency_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "related_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/taskReference"
      }
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "updated_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "completed_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "completed_by_user_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 200
    }
  },
  "$defs": {
    "taskReference": {
      "type": "object",
      "required": ["reference_type", "reference_id", "revision"],
      "properties": {
        "reference_type": {
          "type": "string",
          "enum": ["engineering_activity", "wbs", "document", "risk"]
        },
        "reference_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "revision": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
