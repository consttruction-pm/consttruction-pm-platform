{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-pm.local/contracts/v1/voice-command.v1",
  "title": "Construction PM Voice Command v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "voice_command_id",
    "scope",
    "requested_by",
    "input_language",
    "transcript",
    "query_kind",
    "captured_at",
    "source"
  ],
  "properties": {
    "contract_version": { "const": "voice-command.v1" },
    "voice_command_id": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "project_id", "project_revision"],
      "properties": {
        "tenant_id": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "project_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "requested_by": { "type": "string", "minLength": 1 },
    "input_language": { "type": "string", "minLength": 1 },
    "transcript": { "type": "string", "minLength": 1 },
    "query_kind": {
      "type": "string",
      "enum": ["fact", "explanation", "filter", "scenario"]
    },
    "captured_at": { "type": "string", "minLength": 1 },
    "source": {
      "type": "string",
      "enum": ["microphone", "imported_audio", "manual_transcript"]
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "provenance": {
      "type": ["object", "null"]
    }
  }
}