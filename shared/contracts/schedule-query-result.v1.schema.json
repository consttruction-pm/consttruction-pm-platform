{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-pm.local/contracts/v1/schedule-query-result.v1",
  "title": "Schedule Query Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "query_id",
    "scope",
    "answer_key",
    "data",
    "source_refs",
    "proposed_actions"
  ],
  "properties": {
    "contract_version": {
      "const": "schedule-query-result.v1"
    },
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "project_id",
        "project_revision"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "project_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "answer_key": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object"
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_type",
          "locator",
          "revision"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "excerpt_key": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_hash": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "proposed_actions": {
      "type": "array"
    }
  }
}
