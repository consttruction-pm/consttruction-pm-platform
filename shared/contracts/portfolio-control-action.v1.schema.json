{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-pm.local/contracts/v1/portfolio-control-action.v1",
  "title": "Portfolio Control Action v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version","action_id","tenant_id","portfolio_id","portfolio_revision","target_type","target_id","action_type","source_snapshot_id","expected_portfolio_revision","requested_by","requested_at","status","requires_approval","idempotency_key"],
  "properties": {
    "contract_version": {"const": "portfolio-control-action.v1"},
    "action_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "portfolio_id": {"type": "string", "minLength": 1},
    "portfolio_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "target_type": {"type": "string", "enum": ["portfolio","project"]},
    "target_id": {"type": "string", "minLength": 1},
    "action_type": {"type": "string", "enum": ["request_review","approve","reject","hold_project","resume_project","exclude_project"]},
    "source_snapshot_id": {"type": "string", "minLength": 1},
    "expected_portfolio_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "requested_by": {"type": "string", "minLength": 1},
    "requested_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["proposed","approved","rejected","cancelled"]},
    "requires_approval": {"type": "boolean"},
    "idempotency_key": {"type": "string", "minLength": 1},
    "rationale_key": {"type": ["string","null"], "minLength": 1},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id","source_type","locator","revision"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "source_type": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
          "excerpt_key": {"type": ["string","null"], "minLength": 1},
          "content_hash": {"type": ["string","null"], "minLength": 1}
        }
      }
    },
    "decided_by": {"type": ["string","null"], "minLength": 1},
    "decided_at": {"type": ["string","null"], "format": "date-time"}
  }
}