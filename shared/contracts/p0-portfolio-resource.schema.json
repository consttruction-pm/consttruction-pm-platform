{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-pm.local/contracts/v1/p0-portfolio-resource",
  "title": "P0 Portfolio Resource v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "resource_type",
    "resource_id",
    "tenant_id",
    "portfolio_id",
    "revision",
    "payload"
  ],
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "resource_type": {
      "type": "string",
      "enum": [
        "portfolio",
        "project_link",
        "control_snapshot",
        "decision"
      ]
    },
    "resource_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "portfolio_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
