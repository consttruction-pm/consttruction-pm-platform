{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constructionpm.dev/contracts/v1/p6-activity-period-actual-api.v1.schema.json",
  "title": "P6 Activity Period Actual API v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "kind", "scope", "activity_period_actual"],
  "properties": {
    "contract_version": {"const": "p6-activity-period-actual-api.v1"},
    "kind": {"const": "p6_activity_period_actual"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "project_id", "project_revision"],
      "properties": {
        "tenant_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "project_revision": {"type": "integer", "minimum": 0}
      }
    },
    "activity_period_actual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actual_id", "activity_id", "period_id",
        "actual_units", "actual_cost", "unit", "currency", "note"
      ],
      "properties": {
        "actual_id": {"type": "string", "minLength": 1},
        "activity_id": {"type": "string", "minLength": 1},
        "period_id": {"type": "string", "minLength": 1},
        "actual_units": {"type": ["string", "null"], "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
        "actual_cost": {"type": ["string", "null"], "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},
        "unit": {"type": ["string", "null"]},
        "currency": {"type": ["string", "null"]},
        "note": {"type": ["string", "null"]}
      }
    }
  }
}
