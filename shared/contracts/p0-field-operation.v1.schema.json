{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-pm.local/contracts/p0-field-operation.v1.schema.json",
  "title": "P0 Field Operation Resource v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "project_id", "operation_id", "revision", "operation_type", "occurred_at", "actor_id", "payload"],
  "properties": {
    "tenant_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 0},
    "operation_type": {"type": "string", "enum": ["daily_log", "issue", "observation", "inspection", "quality", "safety", "punch", "photo"]},
    "occurred_at": {"type": "string", "minLength": 1},
    "actor_id": {"type": "string", "minLength": 1},
    "location_ref": {"type": ["string", "null"]},
    "payload": {"type": "object"}
  }
}