{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-pm.local/contracts/v1/field-timecard.v1",
  "title": "Field Timecard v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "timecard_id",
    "scope",
    "person_id",
    "log_date",
    "workplace_key",
    "attendance_status",
    "audit"
  ],
  "properties": {
    "contract_version": {
      "const": "field-timecard.v1"
    },
    "timecard_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "person_id": {
      "type": "string",
      "minLength": 1
    },
    "log_date": {
      "type": "string",
      "format": "date"
    },
    "workplace_key": {
      "type": "string",
      "minLength": 1
    },
    "attendance_status": {
      "type": "string",
      "enum": [
        "present",
        "absent",
        "late",
        "leave",
        "on_site"
      ]
    },
    "start_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "end_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "activity_allocations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/allocation"
      }
    },
    "audit": {
      "$ref": "#/$defs/audit"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "project_id",
        "project_revision"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "project_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "allocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_id",
        "quantity",
        "unit"
      ],
      "properties": {
        "activity_id": {
          "type": "string",
          "minLength": 1
        },
        "quantity": {
          "type": "string",
          "pattern": "^(?!0+(?:\\.0+)?$)(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
        },
        "unit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_by",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "locator",
        "revision"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
