{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "constructionpm://contracts/project-portability/v1",
  "title": "ConstructionPM Project Portability Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "calculation_context"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "project": {
      "type": "object",
      "required": [
        "project_id"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "tenant_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "company_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "calculation_context": {
      "type": "object",
      "required": [
        "calendar_id",
        "calendar_version",
        "scheduling_settings",
        "calculation_schema_version"
      ],
      "properties": {
        "calendar_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "calendar_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "scheduling_settings": {
          "type": "object"
        },
        "calculation_schema_version": {
          "type": "string"
        },
        "calendar_assignments": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project_calendar",
            "default_activity_calendar",
            "default_relationship_lag_calendar"
          ],
          "properties": {
            "project_calendar": {
              "$ref": "#/$defs/calendar_reference"
            },
            "default_activity_calendar": {
              "$ref": "#/$defs/calendar_reference"
            },
            "default_relationship_lag_calendar": {
              "$ref": "#/$defs/calendar_reference"
            }
          }
        },
        "language_context": {
          "type": [
            "object",
            "null"
          ]
        },
        "activity_calendar_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default_calendar_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "default_calendar_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "inherit_project_calendar": {
              "type": "boolean"
            }
          }
        },
        "relationship_lag_calendar_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "default_calendar_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "default_calendar_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "inherit_activity_calendar": {
              "type": "boolean"
            },
            "inherit_project_calendar": {
              "type": "boolean"
            }
          }
        },
        "time_scheduling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "schedule_mode": {
              "type": "string",
              "enum": [
                "EARLIEST",
                "ALAP"
              ]
            },
            "project_start": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "project_finish": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "data_date": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "critical_float_threshold_hours": {
              "type": [
                "string",
                "null"
              ]
            },
            "time_precision": {
              "type": "string",
              "enum": [
                "minute",
                "second",
                "millisecond",
                "microsecond"
              ]
            },
            "rounding_policy": {
              "type": "string",
              "enum": [
                "exact",
                "calendar-boundary"
              ]
            }
          }
        },
        "time_constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "activity_id",
              "type",
              "target"
            ],
            "properties": {
              "activity_id": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "START_NO_EARLIER_THAN",
                  "START_NO_LATER_THAN",
                  "FINISH_NO_EARLIER_THAN",
                  "FINISH_NO_LATER_THAN",
                  "MANDATORY_START",
                  "MANDATORY_FINISH"
                ]
              },
              "target": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        }
      }
    },
    "resource_cost_context": {
      "type": [
        "object",
        "null"
      ]
    },
    "project_rules": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "$defs": {
    "calendar_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calendar_id",
        "calendar_version",
        "kind"
      ],
      "properties": {
        "calendar_id": {
          "type": "string"
        },
        "calendar_version": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "working-day",
            "working-time"
          ]
        }
      }
    }
  }
}
