{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "constructionpm://contracts/p6-baseline-conversion-api/v1",
  "title": "P6 Baseline Conversion API v1",
  "type": "object",
  "required": [
    "contract_version",
    "kind",
    "source_scope",
    "target_scope",
    "source",
    "baseline",
    "activity_count",
    "currencies",
    "replayed"
  ],
  "properties": {
    "contract_version": {"const": "p6-baseline-conversion-api.v1"},
    "kind": {"const": "p6_baseline_conversion"},
    "source_scope": {"$ref": "#/$defs/scope"},
    "target_scope": {"$ref": "#/$defs/scope"},
    "source": {
      "type": "object",
      "required": ["kind", "baseline_id", "project_revision"],
      "properties": {
        "kind": {"enum": ["CURRENT", "BASELINE"]},
        "baseline_id": {"type": ["string", "null"]},
        "project_revision": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "baseline": {
      "type": "object",
      "required": [
        "baseline_id",
        "name",
        "baseline_type",
        "source_revision",
        "created_at"
      ],
      "properties": {
        "baseline_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "baseline_type": {
          "enum": ["PRIMARY", "SECONDARY", "TERTIARY", "USER_SELECTED"]
        },
        "source_revision": {"type": "integer", "minimum": 0},
        "created_at": {"type": "string", "minLength": 1},
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "activity_count": {"type": "integer", "minimum": 1},
    "currencies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["currency", "activity_count", "total_budget"],
        "properties": {
          "currency": {"type": "string", "minLength": 1},
          "activity_count": {"type": "integer", "minimum": 1},
          "total_budget": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "replayed": {"type": "boolean"}
  },
  "$defs": {
    "scope": {
      "type": "object",
      "required": ["tenant_id", "project_id", "project_revision"],
      "properties": {
        "tenant_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "project_revision": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
