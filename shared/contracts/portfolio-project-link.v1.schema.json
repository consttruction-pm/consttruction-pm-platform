{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-pm.local/contracts/v1/portfolio-project-link.v1",
  "title": "Portfolio Project Link v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "link_id",
    "portfolio_id",
    "tenant_id",
    "project_id",
    "project_revision",
    "status",
    "role",
    "audit"
  ],
  "properties": {
    "contract_version": {
      "const": "portfolio-project-link.v1"
    },
    "link_id": {
      "type": "string",
      "minLength": 1
    },
    "portfolio_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "project_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "status": {
      "type": "string",
      "enum": [
        "included",
        "on_hold",
        "excluded"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "member",
        "program",
        "priority",
        "reference"
      ]
    },
    "display_name_key": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "manager_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "audit": {
      "$ref": "#/$defs/audit"
    }
  },
  "$defs": {
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_by",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "locator",
        "revision"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
