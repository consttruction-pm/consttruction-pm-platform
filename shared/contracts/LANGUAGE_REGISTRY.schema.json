{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-pm.local/contracts/v1/language-registry.schema.json",
  "x-contract-version": "1.0",
  "title": "Construction PM Global Language Registry",
  "type": "object",
  "required": [
    "schema_version",
    "default_language",
    "languages"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "default_language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "language_tag",
          "enabled",
          "direction",
          "locale",
          "fallback_chain",
          "capabilities",
          "typography"
        ],
        "properties": {
          "language_tag": {
            "type": "string"
          },
          "display_names": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "enabled": {
            "type": "boolean"
          },
          "direction": {
            "enum": [
              "ltr",
              "rtl"
            ]
          },
          "locale": {
            "type": "string"
          },
          "fallback_chain": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "capabilities": {
            "type": "object",
            "required": [
              "ui",
              "help",
              "ai_text",
              "voice_input",
              "voice_output",
              "offline_ai"
            ],
            "properties": {
              "ui": {
                "type": "boolean"
              },
              "help": {
                "type": "boolean"
              },
              "ai_text": {
                "type": "boolean"
              },
              "voice_input": {
                "type": "boolean"
              },
              "voice_output": {
                "type": "boolean"
              },
              "offline_ai": {
                "type": "boolean"
              }
            }
          },
          "typography": {
            "type": "object",
            "required": [
              "font_family",
              "fallback_families",
              "font_style",
              "font_weight",
              "line_height",
              "letter_spacing",
              "font_feature_settings",
              "font_variant_ligatures",
              "font_kerning"
            ],
            "properties": {
              "font_family": {
                "type": "string",
                "minLength": 1
              },
              "fallback_families": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "font_style": {
                "enum": [
                  "normal",
                  "italic",
                  "oblique"
                ]
              },
              "font_weight": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1000
              },
              "line_height": {
                "type": "string",
                "minLength": 1
              },
              "letter_spacing": {
                "type": "string"
              },
              "font_feature_settings": {
                "type": "string"
              },
              "font_variant_ligatures": {
                "type": "string"
              },
              "font_kerning": {
                "enum": [
                  "auto",
                  "normal",
                  "none"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
