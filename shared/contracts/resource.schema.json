{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "constructionpm://contracts/resource/v1",
  "title": "Resource",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "code",
    "name",
    "type",
    "unit",
    "active"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "labor",
        "machinery",
        "material",
        "other"
      ]
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "calendar_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "active": {
      "type": "boolean"
    }
  }
}