{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-pm.local/contracts/v1/portfolio-control-snapshot.v1",
  "title": "Portfolio Control Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "snapshot_id",
    "portfolio_id",
    "tenant_id",
    "generated_at",
    "summary",
    "projects",
    "source_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "portfolio-control-snapshot.v1"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "portfolio_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_projects",
        "included_projects",
        "on_hold_projects",
        "excluded_projects"
      ],
      "properties": {
        "total_projects": {
          "type": "integer",
          "minimum": 1
        },
        "included_projects": {
          "type": "integer",
          "minimum": 0
        },
        "on_hold_projects": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_projects": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project_id",
          "project_revision",
          "membership_status",
          "status"
        ],
        "properties": {
          "project_id": {
            "type": "string",
            "minLength": 1
          },
          "project_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "membership_status": {
            "type": "string",
            "enum": [
              "included",
              "on_hold",
              "excluded"
            ]
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "name_key": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "schedule_result_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "progress_result_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "cost_result_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "resource_result_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "risk_result_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "claim_result_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "procurement_result_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_type",
          "locator",
          "revision"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "excerpt_key": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "content_hash": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    }
  }
}
