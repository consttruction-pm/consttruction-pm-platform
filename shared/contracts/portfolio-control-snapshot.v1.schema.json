{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-pm.local/contracts/v1/portfolio-control-snapshot.v1",
  "title": "Portfolio Control Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "snapshot_id",
    "portfolio_id",
    "generated_at",
    "projects",
    "source_refs",
    "audit"
  ],
  "properties": {
    "contract_version": {
      "const": "portfolio-control-snapshot.v1"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "portfolio_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "project_id",
          "project_revision",
          "status"
        ],
        "properties": {
          "project_id": {
            "type": "string",
            "minLength": 1
          },
          "project_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "name_key": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "schedule_result_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "progress_result_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "cost_result_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "resource_result_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "risk_result_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "claim_result_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "procurement_result_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "audit": {
      "$ref": "#/$defs/audit"
    }
  },
  "$defs": {
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_by",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "locator",
        "revision"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
