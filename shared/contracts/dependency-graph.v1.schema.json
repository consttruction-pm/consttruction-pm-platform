{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-pm.local/contracts/v1/dependency-graph.v1",
  "title": "Dependency Graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "scope",
    "nodes",
    "edges"
  ],
  "properties": {
    "contract_version": {
      "const": "dependency-graph.v1"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "project_id",
        "project_revision"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "project_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "domain",
          "entity_type",
          "entity_id",
          "revision"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "enum": [
              "schedule",
              "progress",
              "evm",
              "resource",
              "cost",
              "document",
              "change",
              "claim",
              "procurement",
              "field"
            ]
          },
          "entity_type": {
            "type": "string",
            "minLength": 1
          },
          "entity_id": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "attributes": {
            "type": "object"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_node_id",
          "target_node_id",
          "relation",
          "source_revision",
          "target_revision"
        ],
        "properties": {
          "source_node_id": {
            "type": "string",
            "minLength": 1
          },
          "target_node_id": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "string",
            "enum": [
              "depends_on",
              "impacts",
              "supports",
              "evidences",
              "derived_from",
              "allocates",
              "claims_against"
            ]
          },
          "source_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "target_revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "attributes": {
            "type": "object"
          }
        }
      }
    }
  }
}
