{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-pm.local/contracts/v1/portfolio-decision.v1",
  "title": "Portfolio Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "decision_id",
    "portfolio_id",
    "tenant_id",
    "status",
    "decision_type",
    "title_key",
    "requires_approval",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "portfolio-decision.v1"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1
    },
    "portfolio_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "under_review",
        "approved",
        "rejected",
        "implemented",
        "closed",
        "cancelled"
      ]
    },
    "decision_type": {
      "type": "string",
      "enum": [
        "escalate",
        "prioritize",
        "hold",
        "review",
        "sequence",
        "approve"
      ]
    },
    "title_key": {
      "type": "string",
      "minLength": 1
    },
    "detail_key": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "affected_project_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_snapshot_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "impact_link_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "proposed_action_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requires_approval": {
      "type": "boolean"
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "implemented_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "implementation_reference": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_type",
          "locator",
          "revision"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "excerpt_key": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "content_hash": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "requires_approval": {
            "const": true
          }
        },
        "required": [
          "requires_approval"
        ]
      },
      "then": {
        "if": {
          "properties": {
            "status": {
              "enum": [
                "approved",
                "implemented",
                "closed"
              ]
            }
          },
          "required": [
            "status"
          ]
        },
        "then": {
          "required": [
            "approved_by",
            "approved_at"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "implemented"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "implemented_at",
          "implementation_reference"
        ]
      }
    }
  ]
}
