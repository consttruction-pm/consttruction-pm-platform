{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-pm.local/contracts/v1/safety-observation.v1",
  "title": "safety-observation.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "observation_id",
    "scope",
    "category_key",
    "severity",
    "status",
    "title_key",
    "observed_by",
    "audit",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "safety-observation.v1"
    },
    "observation_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "audit": {
      "$ref": "#/$defs/audit"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "category_key": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "closed",
        "cancelled"
      ]
    },
    "title_key": {
      "type": "string",
      "minLength": 1
    },
    "observed_by": {
      "type": "string",
      "minLength": 1
    },
    "location_key": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "activity_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "immediate_action_key": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "root_cause_key": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "project_id",
        "project_revision"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "project_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_by",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "locator",
        "revision"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    }
  }
}
