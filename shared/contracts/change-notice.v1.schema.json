{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-pm.local/contracts/change-notice.v1.schema.json",
  "title": "Change Notice v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "notice_id",
    "scope",
    "notice_type",
    "status",
    "title_key",
    "submitted_by",
    "audit",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "change-notice.v1"
    },
    "notice_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "project_id",
        "project_revision"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "project_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "notice_type": {
      "type": "string",
      "enum": [
        "potential_change",
        "instruction",
        "variation",
        "delay_notice",
        "claim_notice"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "under_review",
        "approved",
        "rejected",
        "withdrawn",
        "closed"
      ]
    },
    "title_key": {
      "type": "string",
      "minLength": 1
    },
    "detail_key": {
      "type": "string",
      "minLength": 1
    },
    "submitted_by": {
      "type": "string",
      "minLength": 1
    },
    "notice_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "schedule_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cost_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dependency_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_type",
          "locator",
          "revision"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      },
      "minItems": 1
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_by",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "approval_required": {
      "type": "boolean"
    },
    "attributes": {
      "type": "object"
    }
  }
}
