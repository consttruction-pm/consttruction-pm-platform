{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Construction PM Offline AI Model Pack Manifest",
  "type": "object",
  "required": ["package_id","language_tag","model_type","version","min_app_version","size_bytes","checksum","signature","capabilities"],
  "properties": {
    "package_id":{"type":"string"},
    "language_tag":{"type":"string"},
    "model_type":{"enum":["ai_text","voice_input","voice_output"]},
    "version":{"type":"string"},
    "min_app_version":{"type":"string"},
    "max_app_version":{"type":["string","null"]},
    "size_bytes":{"type":"integer","minimum":0},
    "checksum":{"type":"string"},
    "signature":{"type":"string"},
    "download_uri":{"type":["string","null"]},
    "capabilities":{
      "type":"object",
      "required":["offline","min_ram_mb"],
      "properties":{
        "offline":{"type":"boolean"},
        "min_ram_mb":{"type":"integer","minimum":0},
        "min_storage_mb":{"type":"integer","minimum":0}
      }
    }
  }
}