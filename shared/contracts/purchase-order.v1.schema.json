{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-pm.local/contracts/v1/purchase-order.v1",
  "title": "Purchase Order v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "po_id",
    "scope",
    "supplier_id",
    "status",
    "currency",
    "items",
    "audit",
    "evidence_refs"
  ],
  "properties": {
    "contract_version": {
      "const": "purchase-order.v1"
    },
    "po_id": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "rfq_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "quote_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "supplier_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "issued",
        "partially_received",
        "closed",
        "cancelled"
      ]
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "order_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "required_delivery_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "description_key",
          "quantity",
          "unit",
          "unit_price"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "description_key": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "$ref": "#/$defs/qty"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "unit_price": {
            "$ref": "#/$defs/money"
          },
          "activity_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "delivery_location_key": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    },
    "commitment_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "approval_reference": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "audit": {
      "$ref": "#/$defs/audit"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "project_id",
        "project_revision"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "project_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_by",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "created_by": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "locator",
        "revision"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "money": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
    },
    "qty": {
      "type": "string",
      "pattern": "^(?!0+(?:\\.0+)?$)(?:0|[1-9]\\d*)(?:\\.\\d+)?$"
    }
  }
}
