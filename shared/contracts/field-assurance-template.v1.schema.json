{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-pm.local/contracts/v1/field-assurance-template.v1",
  "title": "field-assurance-template.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "template_id",
    "scope",
    "template_version",
    "template_type",
    "title_key",
    "items"
  ],
  "properties": {
    "contract_version": {"const": "field-assurance-template.v1"},
    "template_id": {"type": "string", "minLength": 1},
    "scope": {"$ref": "#/$defs/scope"},
    "template_version": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "template_type": {"type": "string", "enum": ["inspection", "quality", "safety"]},
    "title_key": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenant_id", "project_id", "project_revision"],
      "properties": {
        "tenant_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "project_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "order", "criterion_key", "input_type", "required"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 1},
        "criterion_key": {"type": "string", "minLength": 1},
        "input_type": {"type": "string", "enum": ["boolean", "select", "text", "number"]},
        "required": {"type": "boolean"},
        "options": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
