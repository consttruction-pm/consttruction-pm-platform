{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Construction PM Language Pack Manifest",
  "type": "object",
  "required": ["package_id","language_tag","version","app_compatibility","artifact","resources","integrity","capabilities"],
  "properties": {
    "package_id": {"type":"string"},
    "language_tag": {"type":"string"},
    "version": {"type":"string"},
    "app_compatibility": {
      "type":"object",
      "required":["min_version"],
      "properties": {
        "min_version":{"type":"string"},
        "max_version":{"type":["string","null"]}
      }
    },
    "artifact": {
      "type":"object",
      "required":["format","compressed_size_bytes","download_uri"],
      "properties": {
        "format":{"enum":["zip","zstd","tar.zst"]},
        "compressed_size_bytes":{"type":"integer","minimum":0},
        "download_uri":{"type":"string"},
        "delta_from":{"type":["string","null"]}
      }
    },
    "resources": {
      "type":"object",
      "required":["translation","glossary","help","reports"],
      "properties": {
        "translation":{"type":"string"},
        "glossary":{"type":"string"},
        "help":{"type":"string"},
        "reports":{"type":"string"},
        "voice_input":{"type":["string","null"]},
        "voice_output":{"type":["string","null"]},
        "offline_ai_model":{"type":["string","null"]}
      }
    },
    "integrity": {
      "type":"object",
      "required":["checksum","signature"],
      "properties": {
        "checksum":{"type":"string"},
        "signature":{"type":"string"},
        "signing_key_id":{"type":["string","null"]}
      }
    },
    "capabilities": {
      "type":"object",
      "required":["ui","help","ai_text","voice_input","voice_output","offline_ai"],
      "properties": {
        "ui":{"type":"boolean"},
        "help":{"type":"boolean"},
        "ai_text":{"type":"boolean"},
        "voice_input":{"type":"boolean"},
        "voice_output":{"type":"boolean"},
        "offline_ai":{"type":"boolean"}
      }
    },
    "rollback": {
      "type":"object",
      "properties": {
        "previous_version":{"type":["string","null"]},
        "rollback_supported":{"type":"boolean"}
      }
    }
  }
}