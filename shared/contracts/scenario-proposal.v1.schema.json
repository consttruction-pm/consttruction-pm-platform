{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-pm.local/contracts/v1/scenario-proposal.v1",
  "title": "Control Intelligence Scenario Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "scenario_id",
    "base_scope",
    "impacts",
    "proposed_changes",
    "authoritative_mutation_allowed"
  ],
  "properties": {
    "contract_version": {
      "const": "scenario-proposal.v1"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1
    },
    "base_scope": {
      "$ref": "#/$defs/scope"
    },
    "impacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/impact"
      }
    },
    "proposed_changes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "authoritative_mutation_allowed": {
      "const": false
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "project_id",
        "project_revision"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "project_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type",
        "locator",
        "revision"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "excerpt_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "content_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "entity_type",
        "entity_id",
        "impact_type",
        "description_key",
        "source_refs"
      ],
      "properties": {
        "domain": {
          "type": "string",
          "enum": [
            "schedule",
            "progress",
            "evm",
            "resource",
            "cost",
            "document",
            "change",
            "claim",
            "procurement",
            "field"
          ]
        },
        "entity_type": {
          "type": "string",
          "minLength": 1
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "impact_type": {
          "type": "string",
          "minLength": 1
        },
        "description_key": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_id",
        "domain",
        "entity_type",
        "entity_id",
        "operation",
        "proposed_value",
        "source_refs"
      ],
      "properties": {
        "change_id": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "enum": [
            "schedule",
            "progress",
            "evm",
            "resource",
            "cost",
            "document",
            "change",
            "claim",
            "procurement",
            "field"
          ]
        },
        "entity_type": {
          "type": "string",
          "minLength": 1
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "proposed_value": {
          "type": "object"
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        }
      }
    }
  }
}
