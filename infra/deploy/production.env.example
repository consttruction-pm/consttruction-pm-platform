# Production environment template — values are placeholders only.
# Copy this file into the deployment secret/config system. Never commit real
# credentials. The readiness validator names variables but never prints values.
#
#   CONSTRUCTION_PM_ENVIRONMENT=production

CONSTRUCTION_PM_ENVIRONMENT=production
CONSTRUCTION_PM_SERVICE_NAME=construction-pm

# PostgreSQL is mandatory in production; SQLite is rejected by validation.
CONSTRUCTION_PM_DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@replace-host.example:5432/replace_database

# Object storage is mandatory in production; local disk is rejected.
CONSTRUCTION_PM_DOCUMENT_STORAGE=s3
CONSTRUCTION_PM_S3_ENDPOINT_URL=https://replace-s3-endpoint.example
CONSTRUCTION_PM_S3_BUCKET=replace-private-bucket
CONSTRUCTION_PM_S3_REGION=replace-region
CONSTRUCTION_PM_S3_ACCESS_KEY=REPLACE_ACCESS_KEY
CONSTRUCTION_PM_S3_SECRET_KEY=REPLACE_SECRET_KEY
CONSTRUCTION_PM_S3_PREFIX=documents
CONSTRUCTION_PM_S3_PATH_STYLE=true
CONSTRUCTION_PM_S3_SSE=AES256

# A real scanner is an external dependency. The reference scanner is rejected
# in production configuration.
CONSTRUCTION_PM_SCANNER=external
CONSTRUCTION_PM_SCANNER_ENDPOINT=https://replace-scanner.example/scan
CONSTRUCTION_PM_REQUIRE_SCANNED_CONTENT=true

# OCR is optional; leave disabled unless an approved engine is configured.
CONSTRUCTION_PM_OCR=disabled

# Durable schedule/OCR execution is mandatory in production.
CONSTRUCTION_PM_JOB_QUEUE=durable

# Retention and legal-hold enforcement are mandatory in production.
CONSTRUCTION_PM_RETENTION=enabled

# Production logs must be JSON. An OTLP endpoint is optional.
CONSTRUCTION_PM_LOG_FORMAT=json
CONSTRUCTION_PM_LOG_LEVEL=info
# CONSTRUCTION_PM_OTEL_ENDPOINT=https://replace-otel.example
