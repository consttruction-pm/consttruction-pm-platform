    "project_id": {"type": "string", "minLength": 1},
    "project_schema_version": {"type": "integer", "minimum": 1},
    "calendar_id": {"type": ["string", "null"], "minLength": 1},
    "calendar_version": {"type": ["integer", "null"], "minimum": 1},
    "scheduling_settings_version": {"type": ["integer", "null"], "minimum": 1},
    "calculation_settings_version": {"type": ["integer", "null"], "minimum": 1}
  },
