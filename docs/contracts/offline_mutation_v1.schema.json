{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "construction-pm/offline-mutation-v1.json",
  "title": "Construction PM Offline Mutation v1",
  "type": "object",
  "required": ["contract_version", "context", "operation", "idempotency_key", "mutation"],
  "properties": {
    "contract_version": {"const": "offline-mutation.v1"},
    "context": {"type": "object"},
    "operation": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "expected_revision": {"type": ["integer", "null"], "minimum": 1},
    "attempt": {"type": "integer", "minimum": 0},
    "mutation": {"type": "object"}
  },
  "additionalProperties": false
}
