{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://construction-pm.local/contracts/v1/resource-api.schema.json",
  "title": "Resource API Contract v1",
  "type": "object",
  "required": ["contract_version", "operation"],
  "properties": {
    "contract_version": {"const": "resource.v1"},
    "operation": {"enum": ["create_resource", "create_assignment"]},
    "revision": {"type": ["integer", "null"], "minimum": 1},
    "active": {"type": ["boolean", "null"]},
    "rates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rate", "basis", "currency", "effective_from", "effective_to", "version"],
        "properties": {
          "rate": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
          "basis": {"enum": ["per_unit", "per_hour", "per_day", "lump_sum"]},
          "currency": {"type": "string", "minLength": 1},
          "effective_from": {"type": ["string", "null"], "format": "date"},
          "effective_to": {"type": ["string", "null"], "format": "date"},
          "version": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "planned_units": {"type": ["string", "null"]},
    "actual_units": {"type": ["string", "null"]},
    "remaining_units": {"type": ["string", "null"]},
    "planned_cost": {"type": ["string", "null"]},
    "actual_cost": {"type": ["string", "null"]},
    "remaining_cost": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
