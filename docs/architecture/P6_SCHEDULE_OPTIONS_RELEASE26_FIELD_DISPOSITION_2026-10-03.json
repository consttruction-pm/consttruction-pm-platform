    "known_gaps": [
      {
        "gap": "priority-field-coverage",
        "detail": "Current-main-based implementation candidate in PR #1457 supports nine fields: Activity ID, Activity Priority, Early Start, Early Finish, Late Start, Late Finish, Free Float, Remaining Duration, and Total Float. CPM-derived Late Start/Late Finish and Free Float come from authoritative CPM outputs; Remaining Duration comes from the activity model. The remaining four documented values not yet represented in the resolver are original_or_planned_duration, planned_finish, project_planned_start, and project_priority.",
        "status": "partially_implemented_pending_exact_head_ci_and_semantic_review"
      },
      {
        "gap": "hierarchy-sort",
        "detail": "Current SortOrder enum supports ASCENDING and DESCENDING only; P6 hierarchy sort semantics are not represented.",
        "status": "documented_gap"
      },
      {
        "gap": "multi-field-precedence-and-wire-roundtrip",
        "detail": "Current PR #1457 contains regression coverage for numeric/alphabetic Activity ID ordering, ordered Total Float vs Activity Priority during backward rollback, CPM-derived Late Finish and Free Float priorities, and Remaining Duration sourced from the activity model. Remaining acceptance must cover broader multi-field precedence across the nine implemented and four missing fields, all sort-direction/tie combinations, lossless REST/interchange -> ScheduleOptions -> Shared Core round-trip, and deterministic backward retry results.",
        "status": "partially_implemented_pending_acceptance"
      }
    ],
    "source_references": [
      "https://docs.oracle.com/cd/G48902_01/English/User_Guides/p6_pro_user/leveling_priority_definitions.htm",
      "https://docs.oracle.com/cd/G48902_01/English/User_Guides/p6_pro_user/specify_leveling_priorities.htm",
