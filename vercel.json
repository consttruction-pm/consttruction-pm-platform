{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm --prefix apps/web ci --no-audit --no-fund",
  "buildCommand": "bash scripts/vercel_build.sh",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "runtime": "python3.12",
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": ["src/**", "requirements.txt"]
    },
    "api/shell.py": {
      "runtime": "python3.12",
      "memory": 512,
      "maxDuration": 15,
      "includeFiles": ["src/**", "apps/web/app.html", "apps/web/login.html", "requirements.txt"]
    }
  },
  "rewrites": [
    { "source": "/app", "destination": "/api/shell" },
    { "source": "/app/", "destination": "/api/shell" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/api/:path*", "destination": "/api/index?__path=:path*" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/app",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
