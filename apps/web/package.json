{
  "name": "@construction-pm/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npx --yes esbuild@0.28.2 src/main.ts --bundle --format=esm --target=es2022 --outfile=dist/web/src/main.bundle.js",
    "preview": "npm run build && node preview-server.mjs",
    "preview:full": "npm run build && node preview-full.mjs",
    "preview:smoke": "node preview-smoke.mjs",
    "test:e2e:preview": "npm run build && node e2e/preview-e2e.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && tsx --test src/*.test.ts && node --test preview-server.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.0.0"
  }
}
