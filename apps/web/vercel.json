{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --no-audit --no-fund && node scripts/prepare-vercel-runtime.mjs",
  "buildCommand": "node scripts/vercel-project-build.mjs",
  "outputDirectory": "vercel-site",
  "functions": {
    "api/index.py": {
      "includeFiles": "vercel-runtime/**"
    },
    "api/shell.py": {
      "includeFiles": "vercel-runtime/**"
    }
  },
  "rewrites": [
    {
      "source": "/workbench/:path*",
      "destination": "/api/shell?__path=workbench/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/shell?__path=admin/:path*"
    },
    {
      "source": "/app",
      "destination": "/api/shell?__path=app"
    },
    {
      "source": "/app/",
      "destination": "/api/shell?__path=app"
    },
    {
      "source": "/app/:path*/",
      "destination": "/api/shell?__path=app/:path*"
    },
    {
      "source": "/app/:path*",
      "destination": "/api/shell?__path=app/:path*"
    },
    {
      "source": "/workbench",
      "destination": "/api/shell?__path=workbench"
    },
    {
      "source": "/workbench/",
      "destination": "/api/shell?__path=workbench"
    },
    {
      "source": "/admin",
      "destination": "/api/shell?__path=admin"
    },
    {
      "source": "/admin/",
      "destination": "/api/shell?__path=admin"
    },
    {
      "source": "/ai-workbench/",
      "destination": "/api/shell?__path=ai-workbench"
    },
    {
      "source": "/cubi/",
      "destination": "/api/shell?__path=cubi"
    },
    {
      "source": "/login/",
      "destination": "/login.html"
    },
    {
      "source": "/enterprise",
      "destination": "/api/shell?__path=enterprise"
    },
    {
      "source": "/enterprise/",
      "destination": "/api/shell?__path=enterprise"
    },
    {
      "source": "/cubi",
      "destination": "/api/shell?__path=cubi"
    },
    {
      "source": "/cubi/:path*/",
      "destination": "/api/shell?__path=cubi/:path*"
    },
    {
      "source": "/cubi/:path*",
      "destination": "/api/shell?__path=cubi/:path*"
    },
    {
      "source": "/ai-workbench",
      "destination": "/api/shell?__path=ai-workbench"
    },
    {
      "source": "/ai-workbench/:path*",
      "destination": "/api/shell?__path=ai-workbench/:path*"
    },
    {
      "source": "/app.html",
      "destination": "/api/shell?__path=app"
    },
    {
      "source": "/login",
      "destination": "/login.html"
    },
    {
      "source": "/preview",
      "destination": "/api?__path=preview"
    },
    {
      "source": "/preview/:path*",
      "destination": "/api?__path=preview/:path*"
    },
    {
      "source": "/dist/main.bundle.js",
      "destination": "/dist/web/src/main.bundle.js"
    },
    {
      "source": "/dist/global-assistant-launcher.bundle.js",
      "destination": "/dist/web/src/global-assistant-launcher.bundle.js"
    },
    {
      "source": "/dist/enterprise-entry.bundle.js",
      "destination": "/dist/web/src/enterprise-entry.bundle.js"
    },
    {
      "source": "/dist/ai-workbench-entry.bundle.js",
      "destination": "/dist/web/src/ai-workbench-entry.bundle.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/api?__path=:path*"
    },
    {
      "source": "/workbench",
      "destination": "/api/shell?__path=app"
    },
    {
      "source": "/workbench/",
      "destination": "/api/shell?__path=app"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/preview/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/app",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/login.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/app/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/app.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/enterprise",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/enterprise/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/cubi/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/ai-workbench/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
